# Personal API key or OAuth token with write access to the issues you sync.
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxxxxxx

# Optional: restrict the sync to a single team key (e.g. ENG).
LINEAR_TEAM_KEY=

# Optional overrides.
LINEAR_API_URL=https://api.linear.app/graphql
LINEAR_PAGE_SIZE=50
LINEAR_MAX_RETRIES=5
LINEAR_DRY_RUN=false

# Name of the label group the sync manages. It only ever adds or removes
# labels inside this group.
LINEAR_LABEL_GROUP=Parent progress

# Create the label group and any missing buckets when absent. On by default so
# scheduled runs are self-initializing; set false to make a missing group an
# error instead. Name/type/parent collisions always fail regardless.
LINEAR_BOOTSTRAP_LABELS=true

# Strip '[042%] ' title prefixes left by the old title-prefix version.
LINEAR_CLEANUP_LEGACY_PREFIXES=false
